<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head th:replace="~{fragments/layout :: pageHead('Settings')}"></head>
<body>
<nav th:replace="~{fragments/layout :: nav}"></nav>

<div class="container pb-5" style="max-width: 560px;">
    <h2 class="page-title mb-3">Settings</h2>

    <div class="alert alert-success" th:if="${successMessage}" th:text="${successMessage}"></div>
    <div class="alert alert-danger" th:if="${errorMessage}" th:text="${errorMessage}"></div>

    <div class="card p-4 bg-white">
        <h5 class="mb-3">Mess logo</h5>

        <div th:if="${hasLogo}" class="mb-3">
            <p class="text-secondary small mb-2">Current logo:</p>
            <img th:src="@{'/uploads/' + ${logoFilename}}" alt="Current logo" style="max-height: 90px; max-width: 100%;"/>
        </div>
        <div th:unless="${hasLogo}" class="mb-3 text-secondary small">
            No logo uploaded yet - the navbar is showing the default text name.
        </div>

        <form th:action="@{/settings/logo}" method="post" enctype="multipart/form-data">
            <label class="form-label">Upload a new logo (PNG, JPG, GIF, or SVG - under 5 MB)</label>
            <input type="file" name="logoFile" accept="image/*" class="form-control" required/>
            <button type="submit" class="btn btn-success mt-3">Upload logo</button>
        </form>
    </div>
</div>
</body>
</html>
